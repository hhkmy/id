{
    "plugins": [
        "prettier-plugin-go-template",
        "@awmottaz/prettier-plugin-void-html"
    ],
    "overrides": [
        {
            "files": ["*.html"],
            "options": {
                "parser": "go-template",
                "semi": false,
                "printWidth": 80,
                "tabWidth": 2,
                "useTabs": false,
                "singleQuote": true
            }
        },
        {
            "files": ".prettierrc",
            "options": {
                "parser": "json",
                "tabWidth": 4
            }
        }
    ]
}
