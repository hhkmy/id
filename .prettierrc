{
    "plugins": ["prettier-plugin-go-template"],
    "overrides": [
        {
            "files": ["*.html"],
            "options": {
                "parser": "go-template",
                "printWidth": 169,
                "tabWidth": 4,
                "useTabs": true,
                "bracketSpacing": false
            }
        },
        {
            "files": ["*.toml"],
            "options": {
                "tabWidth": 4
            }
        },
        {
            "files": ".prettierrc",
            "options": {
                "parser": "json",
                "tabWidth": 4
            }
        }
    ]
}
