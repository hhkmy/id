# -----------------------------------------------------------------------------
# Environment Configuration Template
# Copy this file to .env and configure your credentials as needed.
# -----------------------------------------------------------------------------

# SonarCloud Analysis Token
# Required for running local SonarCloud scans (npm run sonar) and querying issues (npm run sonar:issues)
# Generate from: https://sonarcloud.io/account/security
SONAR_TOKEN=""

# FOSSA License Compliance API Key
# Required for uploading scans to FOSSA Cloud (npm run fossa) and policy tests (npm run fossa:test)
# Generate from: https://app.fossa.com/account/settings/integrations/api_tokens
FOSSA_API_KEY=""

# Cloudflare Credentials (Optional - Wrangler will prompt interactively if omitted)
# Required for non-interactive automated deployments via npm run deploy:cloudflare
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# Telegram Bot Token (Optional - for local KV sync and bot testing)
TELEGRAM_BOT_TOKEN=""

# Google Chrome UX Report (CrUX) API Key (Optional - for Speedlify field metrics & INP)
# Generate from: https://console.cloud.google.com/apis/credentials
CRUX_API_KEY=""
