{
  "name": "hhkmyid",
  "version": "1.0.0",
  "description": "A Hugo-powered personal technology blog and practical knowledge base.",
  "scripts": {
    "watch:hugo": "hugo server --disableFastRender",
    "build": "hugo --gc --minify",
    "postbuild": "pagefind --site \"public\"",
    "pagefind": "pagefind --site \"public\"",
    "build:search": "npm run build",
    "lighthouse:pages": "node scripts/lighthouse-pages.mjs --site https://hhk.my.id",
    "lighthouse:pages:sample": "node scripts/lighthouse-pages.mjs --site https://hhk.my.id --limit 5",
    "deploy:cloudflare": "npx --ignore-scripts -y wrangler@4.131.1 deploy",
    "deploy:cloudflare:ci": "npm ci --ignore-scripts && npx --ignore-scripts -y wrangler@4.131.1 deploy",
    "deploy:cloudflare:version": "npx --ignore-scripts -y wrangler@4.131.1 versions upload && npx --ignore-scripts -y wrangler@4.131.1 versions deploy -y && npx --ignore-scripts -y wrangler@4.131.1 triggers deploy",
    "deploy:cloudflare:version:ci": "npm ci --ignore-scripts && npm run deploy:cloudflare:version",
    "format": "prettier --write \"**/*.{html,js,json,css,md}\"",
    "sonar": "node --env-file-if-exists=.env scripts/sonar.mjs",
    "precommit": "lint-staged"
  },
  "keywords": [
    "hugo",
    "technology-blog",
    "myanmar"
  ],
  "author": "Hein Htet Kyaw",
  "license": "ISC",
  "engines": {
    "node": "24.18.1"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^5.1.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.13.4",
    "lint-staged": "^17.5.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-go-template": "^0.0.15",
    "sass": "^1.104.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "toml-eslint-parser": "^1.0.3"
  },
  "lint-staged": {
    "*.{json,css,md,html}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "autoprefixer": "^10.5.5",
    "clipboard": "^2.0.11",
    "lottie-web": "^5.13.0",
    "mermaid": "^12.0.0",
    "postcss-cli": "^12.0.0",
    "rtlcss": "^4.3.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  },
  "lavamoat": {
    "allowScripts": {
      "sass>@parcel/watcher#2.5.1": false
    }
  }
}
