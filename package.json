{
  "name": "hhkmyid",
  "version": "1.0.0",
  "description": "A Hugo-powered personal technology blog and practical knowledge base.",
  "scripts": {
    "dev": "hugo server --disableFastRender",
    "watch:hugo": "hugo server --disableFastRender",
    "dev:worker": "NODE_OPTIONS=\"--dns-result-order=ipv4first\" npx wrangler dev",
    "build": "hugo --gc --minify",
    "postbuild": "pagefind --site \"public\"",
    "pagefind": "pagefind --site \"public\"",
    "build:search": "npm run build",
    "emoji:sync": "node scripts/sync-emoji.mjs --all",
    "emoji:download": "node scripts/sync-emoji.mjs",
    "emoji:upload": "node scripts/sync-emoji.mjs --all --upload-all",
    "kv:sync:services": "node scripts/sync-kv-services.mjs",
    "kv:sync": "npm run kv:sync:services && npm run emoji:sync",
    "lighthouse:pages": "node scripts/lighthouse-pages.mjs --site https://hhk.my.id",
    "lighthouse:pages:sample": "node scripts/lighthouse-pages.mjs --site https://hhk.my.id --limit 5",
    "deploy:cloudflare": "npx --ignore-scripts -y wrangler@4.131.1 deploy",
    "deploy:cloudflare:ci": "npm ci --ignore-scripts && npx --ignore-scripts -y wrangler@4.131.1 deploy",
    "deploy:cloudflare:version": "npx --ignore-scripts -y wrangler@4.131.1 versions upload && npx --ignore-scripts -y wrangler@4.131.1 versions deploy -y && npx --ignore-scripts -y wrangler@4.131.1 triggers deploy",
    "deploy:cloudflare:version:ci": "npm ci --ignore-scripts && npm run deploy:cloudflare:version",
    "format": "prettier --write \"**/*.{html,js,json,css,md}\"",
    "sonar": "node --dns-result-order=ipv4first --env-file-if-exists=.env scripts/sonar.mjs",
    "sonar:issues": "node --dns-result-order=ipv4first --env-file-if-exists=.env scripts/sonar.mjs --issues",
    "precommit": "lint-staged"
  },
  "keywords": [
    "hugo",
    "technology-blog",
    "myanmar"
  ],
  "author": "Hein Htet Kyaw",
  "license": "ISC",
  "engines": {
    "node": ">=24.18.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.13.4",
    "lint-staged": "^17.5.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-go-template": "^0.0.15",
    "sonarqube-scanner": "^5.0.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3"
  },
  "lint-staged": {
    "*.{json,css,md,html}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "clipboard": "^2.0.11",
    "lottie-web": "^5.13.0",
    "mermaid": "^12.0.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "adm-zip": "^0.6.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  }
}
