{
  "name": "ksvblog",
  "version": "1.0.0",
  "description": "K's V/Blog Website nth more with testing my learning skills",
  "main": "index.js",
  "scripts": {
    "watch:hugo": "hugo server --disableFastRender",
    "build": "hugo --gc --minify",
    "pagefind": "pagefind --site \"public\"",
    "build:search": "npm run build && npm run pagefind",
    "watch:tw": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./assets/css/style.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./assets/css/tailwind.css -o ./assets/css/style.css --minify",
    "format": "prettier --write \"**/*.{html,js,json,css,md}\"",
    "precommit": "lint-staged",
    "prepare": "node .husky/install.mjs"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "keywords": [
    "hguo",
    "tailwindcss",
    "VScode"
  ],
  "author": "Hein Htet Kyaw",
  "license": "ISC",
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "^1.8.0",
    "@tailwindcss/cli": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "prettier-plugin-go-template": "^0.0.15",
    "pagefind": "^1.5.2",
    "sass": "^1.89.2",
    "speedlify-score": "^4.0.4",
    "tailwindcss": "^4.1.10",
    "toml-eslint-parser": "^0.10.0",
    "wrangler": "^4.14.1"
  },
  "lint-staged": {
    "*.{json,css,md,html}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "postcss-cli": "^11.0.1",
    "rtlcss": "^4.3.0"
  }
}
