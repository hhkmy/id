{
  "name": "hhkmyid",
  "version": "1.0.0",
  "description": "K's V/Blog Website nth more with testing my learning skills",
  "main": "index.js",
  "scripts": {
    "watch:hugo": "hugo server --disableFastRender",
    "build": "HUGO_CACHEDIR=\"${HUGO_CACHEDIR:-/tmp/hugo_cache}\" hugo --gc --minify",
    "postbuild": "pagefind --site \"public\"",
    "pagefind": "pagefind --site \"public\"",
    "build:search": "npm run build",
    "lighthouse:pages": "node scripts/lighthouse-pages.mjs --site https://hhk.my.id",
    "lighthouse:pages:sample": "node scripts/lighthouse-pages.mjs --site https://hhk.my.id --limit 5",
    "deploy:cloudflare": "npx -y wrangler@4.107.0 deploy",
    "deploy:cloudflare:ci": "npm ci && npx -y wrangler@4.107.0 deploy",
    "deploy:cloudflare:version": "npx -y wrangler@4.107.0 versions upload && npx -y wrangler@4.107.0 versions deploy -y && npx -y wrangler@4.107.0 triggers deploy",
    "deploy:cloudflare:version:ci": "npm ci && npm run deploy:cloudflare:version",
    "format": "prettier --write \"**/*.{html,js,json,css,md}\"",
    "precommit": "lint-staged"
  },
  "keywords": [
    "hguo",
    "tailwindcss",
    "VScode"
  ],
  "author": "Hein Htet Kyaw",
  "license": "ISC",
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "^2.1.0",
    "@lavamoat/allow-scripts": "^5.1.0",
    "@tailwindcss/cli": "^4.1.10",
    "lint-staged": "^16.4.0",
    "pagefind": "^1.5.2",
    "prettier": "~3.8.5",
    "prettier-plugin-go-template": "^0.0.15",
    "sass": "^1.89.2",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.1.10",
    "toml-eslint-parser": "^1.0.3"
  },
  "lint-staged": {
    "*.{json,css,md,html}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "autoprefixer": "^10.5.4",
    "clipboard": "^2.0.11",
    "lottie-web": "^5.13.0",
    "postcss-cli": "^11.0.1",
    "rtlcss": "^4.3.0"
  },
  "lavamoat": {
    "allowScripts": {
      "sass>@parcel/watcher#2.5.1": false
    }
  }
}
