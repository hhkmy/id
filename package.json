{
  "name": "ksvblog",
  "version": "1.0.0",
  "description": "K's V/Blog Website nth more with testing my learning skills",
  "main": "index.js",
  "scripts": {
    "watch:hugo": "hugo server --disableFastRender",
    "build": "hugo --minify --cleanDestinationDir",
    "watch:tw": "tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/style.css --watch",
    "build:css": "tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/style.css --minify",
    "prebuild": "npm run build:css",
    "format": "prettier --write \"**/*.{html,js,json,css,md}\"",
    "precommit": "lint-staged",
    "prepare": "node .husky/install.mjs"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm test && lint-staged"
    }
  },
  "keywords": [
    "hguo",
    "tailwindcss",
    "VScode"
  ],
  "author": "Hein Htet Kyaw",
  "license": "ISC",
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "^1.8.0",
    "@tailwindcss/cli": "^4.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "prettier-plugin-go-template": "^0.0.15",
    "speedlify-score": "^4.0.4",
    "tailwindcss": "^4.1.5",
    "toml-eslint-parser": "^0.10.0"
  },
  "lint-staged": {
    "*.{json,css,md,html}": [
      "prettier --write --ignore-unknown",
      "git add"
    ]
  }
}
